# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_ESP_WIFI_REMOTE_ENABLED is not set
# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_ESP_WIFI_REMOTE_ENABLED is not set
# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_ESP_WIFI_REMOTE_ENABLED is not set
# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_ESP_WIFI_REMOTE_ENABLED is not set
# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_ESP_WIFI_REMOTE_ENABLED is not set
# CONFIG_FORGEUI_SD_ENABLED is not set
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# CONFIG_ESP_WIFI_REMOTE_ENABLED is not set
# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_FORGEUI_SD_ENABLED is not set
# Example 04 HTTPS coexists with ESP-Hosted SDIO: avoid hardware-AES DMA
# descriptor allocations and release TLS RX/TX buffers when they are idle.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# CONFIG_MBEDTLS_DEBUG is not set
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# CONFIG_FORGEUI_SD_ENABLED is not set

# Generated from ForgeUI project hardware profile.
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
# CONFIG_ESP_HOSTED_SPI_HOST_INTERFACE is not set
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PRIV_PIN_D1_4BIT_BUS=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=20
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=20
# CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_NONE is not set
# CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_MAX_SIZE is not set
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
# CONFIG_FORGEUI_SD_ENABLED is not set
CONFIG_FORGEUI_SD_SLOT=0
CONFIG_FORGEUI_SD_WIDTH=4
CONFIG_FORGEUI_SD_FREQ_KHZ=40000
CONFIG_FORGEUI_SD_CLK=43
CONFIG_FORGEUI_SD_CMD=44
CONFIG_FORGEUI_SD_D0=39
CONFIG_FORGEUI_SD_D1=40
CONFIG_FORGEUI_SD_D2=41
CONFIG_FORGEUI_SD_D3=42
CONFIG_FORGEUI_SD_LDO_CHANNEL=4
CONFIG_FORGEUI_SD_LDO_MV=2500
