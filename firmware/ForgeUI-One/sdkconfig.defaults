# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_ESP_WIFI_REMOTE_ENABLED is not set
# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_ESP_WIFI_REMOTE_ENABLED is not set
# CONFIG_FORGEUI_SD_ENABLED is not set

# CONFIG_ESP_WIFI_REMOTE_ENABLED is not set
# CONFIG_FORGEUI_SD_ENABLED is not set

# Generated from ForgeUI project hardware profile.
# CONFIG_ESP_HOSTED_ENABLED is not set
# CONFIG_ESP_WIFI_REMOTE_ENABLED is not set
# CONFIG_FORGEUI_SD_ENABLED is not set
CONFIG_FORGEUI_SD_SLOT=0
CONFIG_FORGEUI_SD_WIDTH=4
CONFIG_FORGEUI_SD_FREQ_KHZ=40000
CONFIG_FORGEUI_SD_CLK=43
CONFIG_FORGEUI_SD_CMD=44
CONFIG_FORGEUI_SD_D0=39
CONFIG_FORGEUI_SD_D1=40
CONFIG_FORGEUI_SD_D2=41
CONFIG_FORGEUI_SD_D3=42
CONFIG_FORGEUI_SD_LDO_CHANNEL=4
CONFIG_FORGEUI_SD_LDO_MV=2500
