# ForgeUI / Waveshare ESP32-P4-WIFI6-Touch-LCD-7B co-processor profile.
# The ESP32-C6 SDIO pins are fixed by the SoC IO_MUX; no board pin override.
CONFIG_ESP_SDIO_HOST_INTERFACE=y
# CONFIG_ESP_SDIO_STREAMING_MODE is not set
CONFIG_ESP_SDIO_HIGH_SPEED=y
CONFIG_ESP_SDIO_PSEND_PSAMPLE=y
CONFIG_ESP_SDIO_GPIO_RESET=-1
CONFIG_ESP_SDIO_TX_Q_SIZE=20
CONFIG_ESP_SDIO_RX_Q_SIZE=20
